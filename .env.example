# Local AI runs through the Ollama service already installed on this PC.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
PORT=4173
# Allow extra time for local model loading and OCR.
AI_TIMEOUT_MS=240000
# For a future GitHub Pages build, set the public backend URL (never an API key).
VITE_API_URL=
VITE_BASE_PATH=/
# Optional cloud provider; secrets belong only on the backend.
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated exact browser origins; empty uses localhost for the Node server.
ALLOWED_ORIGINS=
