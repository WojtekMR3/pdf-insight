{
  "name": "pdf-insight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write src server shared tests scripts .github *.json *.ts *.md docs/*.md",
    "format:check": "prettier --check src server shared tests scripts .github *.json *.ts *.md docs/*.md",
    "verify:cloud": "node --import tsx scripts/verify-cloud.mjs",
    "benchmark": "node --import tsx scripts/benchmark-long.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build && npm run build:worker"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "prettier": "3.8.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "7.3.6",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
